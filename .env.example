# --- Google Sheets (admin/config backend) -----------------------------------
# The spreadsheet ID from the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=

# Service account auth (preferred). EITHER a path to the key file...
GOOGLE_APPLICATION_CREDENTIALS=
# ...OR the JSON key pasted inline (useful on hosts without a filesystem secret):
GOOGLE_SERVICE_ACCOUNT_JSON=

# OAuth fallback for Search Console. Use this when the GSC property owner
# cannot add the service account as a user (service accounts must be added to
# each GSC property under Settings -> Users and permissions; if that isn't
# possible, create an OAuth client, run the consent flow once, and paste the
# refresh token here).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Rank tracking ------------------------------------------------------------
# SE Ranking API key (adapter is a stub in V1 — CSV/sheet import is the working path)
SERANKING_API_KEY=

# --- LLM commentary (optional; the app is fully functional without it) ---------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Set to "true" to let the LLM draft commentary from the deterministic findings.
ENABLE_LLM_COMMENTARY=false
# rules_only | llm_draft (llm_draft only takes effect when enabled + key present)
COMMENTARY_MODE=rules_only

# --- Dashboard ------------------------------------------------------------------
# The app's public address (used in client share links written to the sheet)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Team password. When set, the whole backend requires sign-in; client share
# links (/share/...) stay public but unguessable. Leave empty for local dev.
APP_PASSWORD=
